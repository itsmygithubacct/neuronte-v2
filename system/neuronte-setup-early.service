# The part of Neuronte's setup that a login screen cannot start without:
# the steps the settings name in early=. As shipped no font step is one of
# them (the font files are made by neuronte-setup.service, after the login
# screen), so a login screen waits for no font file. Only the display
# manager is made to wait; a text or remote login is not.
[Unit]
Description=Neuronte setup, early steps (what a login screen needs)
Documentation=file:///usr/share/doc/neuronte/neuronte-fontfile.md
RequiresMountsFor=/var/lib/neuronte /var/cache/fontconfig
After=local-fs.target
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# A step may not hold the start back: see the top of neuronte-setup.
Environment=NEURONTE_SETUP_BOOT=1
ExecStart=/usr/bin/neuronte-setup --early
StateDirectory=neuronte
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
