# Every step of Neuronte's setup, after the early ones and after the login
# screen has started, without holding the start of the machine back:
# Type=exec, so nothing waits for it to end. This is the run that does what
# an early step deferred.
[Unit]
Description=Neuronte setup (font files and caches made from the weights)
Documentation=file:///usr/share/doc/neuronte/neuronte-fontfile.md
RequiresMountsFor=/var/lib/neuronte /var/cache/fontconfig
Wants=neuronte-setup-early.service
After=neuronte-setup-early.service local-fs.target display-manager.service

[Service]
Type=exec
ExecStart=/usr/bin/neuronte-setup
StateDirectory=neuronte
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
